PORT=3000
# Bundled mode (default) scrapes Consumet providers in-process and needs a TMDB key.
# Never expose this key in browser code or commit it.
TMDB_API_KEY=a45420333457411e78d5ad35d6c51a2d
# Optional: use a hosted Consumet REST API instead of the bundled provider scrapers.
# CONSUMET_MODE=api
# CONSUMET_API_URL=https://api.consumet.org
# Providers to try, in order (bundled mode). Comma-separated: flixhq,himovies,sflix,goku
# CONSUMET_PROVIDERS=flixhq
# Preferred streaming servers, in order.
# CONSUMET_SERVERS=upcloud,megacloud,vidcloud,mixdrop
# Max streaming servers tried per title (1-6).
# CONSUMET_MAX_SERVERS=3
# Set a long random secret to preserve media tokens across restarts/replicas.
# MEDIA_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Allowed iframe parent origins (space-separated). Default * allows any site.
# FRAME_ANCESTORS=https://your-streaming-site.example
NODE_ENV=production
