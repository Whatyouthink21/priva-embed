{
  "name": "priva-embed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CinePro-powered iframe player and source API",
  "scripts": {
    "postinstall": "npm ci --prefix vendor/cinepro",
    "build": "npm run build --prefix vendor/cinepro",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "express": "^5.1.0",
    "hls.js": "^1.6.13",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^153.0.0"
  }
}
