{
  "name": "priva-embed",
  "version": "1.0.0",
  "private": true,
  "description": "Priva Embed - a drop-in iframe player that streams movies and TV shows from three providers (Clarke, Bellamy, Nova).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "node scripts/vendor.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "hls.js": "^1.5.20"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
