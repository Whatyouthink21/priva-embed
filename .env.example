# Port (Render sets this automatically)
PORT=3000

# Optional: your own TMDB v3 API key (a public fallback key is used otherwise)
TMDB_API_KEY=

# Optional: lock the embed to your streaming site (comma separated origins)
# ALLOWED_ORIGINS=https://mystreamingsite.com,https://www.mystreamingsite.com

# Optional: public URL used by the docs page snippets
# PUBLIC_URL=https://priva-embed.onrender.com
